{
  "description": "Owned user-level math-tool lifecycle hooks. Review changed definitions with /hooks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "{{MATH_GATE_COMMAND}}",
            "timeout": 30,
            "additionalContextLimit": 180
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{MATH_GATE_COMMAND}}",
            "timeout": 15,
            "additionalContextLimit": 180
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "{{MATH_GATE_COMMAND}}",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "{{MATH_GATE_COMMAND}}",
            "timeout": 15,
            "additionalContextLimit": 512
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{MATH_GATE_COMMAND}}",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "^(manual|auto)$",
        "hooks": [
          {
            "type": "command",
            "command": "{{MATH_GATE_COMMAND}}",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "^other$",
        "hooks": [
          {
            "type": "command",
            "command": "{{MATH_GATE_COMMAND}}",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
