{
	"description": "User-level PERMISSIONS_HARNESS bootstrap. Install the launcher beside hooks.json, merge this definition, then approve it with /hooks.",
	"hooks": {
		"SessionStart": [
			{
				"matcher": "^(startup|resume|clear|compact)$",
				"hooks": [
					{
						"type": "command",
						"command": "PYTHONDONTWRITEBYTECODE=1 python3 \"{{LAUNCHER}}\" --host codex --event SessionStart --hook-scope user",
						"timeout": 600,
						"additionalContextLimit": 2500
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": ".*",
				"hooks": [
					{
						"type": "command",
						"command": "PYTHONDONTWRITEBYTECODE=1 python3 \"{{LAUNCHER}}\" --host codex --event PreToolUse --hook-scope user",
						"timeout": 120
					}
				]
			}
		]
	}
}
