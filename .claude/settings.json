{
	"env": {
		"CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1"
	},
	"hooks": {
		"SessionStart": [
			{
				"matcher": "startup|resume|clear|compact|fork",
				"hooks": [
					{
						"type": "command",
						"command": "python3",
						"args": ["-B", "${CLAUDE_PROJECT_DIR}/shared/gates/harness_gate.py", "--host", "claude", "--event", "SessionStart"],
						"timeout": 30
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "python3",
						"args": ["-B", "${CLAUDE_PROJECT_DIR}/shared/gates/harness_gate.py", "--host", "claude", "--event", "UserPromptSubmit"],
						"timeout": 30
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "python3",
						"args": ["-B", "${CLAUDE_PROJECT_DIR}/shared/gates/harness_gate.py", "--host", "claude", "--event", "Stop"],
						"timeout": 60
					}
				]
			}
		]
	}
}
