{
	"__doc": "the canonical hook block roblox-new-game writes into a project's .claude/settings.json — gates run from the project's .roblox-harness checkout. The deny list closes the paths write-gate cannot parse.",
	"env": {
		"CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
		"CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
	},
	"permissions": {
		"deny": [
			"Edit(**/.luaurc)",
			"Write(**/.luaurc)",
			"mcp__Roblox_Studio__multi_edit",
			"mcp__Roblox_Studio__script_grep",
			"mcp__Roblox_Studio__script_read",
			"mcp__Roblox_Studio__script_search",
			"mcp__Roblox_Studio__generate_mesh",
			"mcp__Roblox_Studio__generate_material",
			"mcp__Roblox_Studio__generate_procedural_model",
			"mcp__Roblox_Studio__search_asset",
			"mcp__Roblox_Studio__screen_capture",
			"mcp__Roblox_Studio__character_navigation",
			"mcp__Roblox_Studio__user_keyboard_input",
			"mcp__Roblox_Studio__user_mouse_input",
			"mcp__Roblox_Studio__wait_job_finished",
			"mcp__Roblox_Studio__skill"
		]
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": ".*",
				"hooks": [
					{
						"type": "command",
						"command": "python3",
						"args": ["-B", "${CLAUDE_PROJECT_DIR}/.roblox-harness/claude/hooks/adapter.py", "--host", "claude", "--event", "PreToolUse", "--hook-scope", "project"],
						"timeout": 4800
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "python3",
						"args": ["-B", "${CLAUDE_PROJECT_DIR}/.roblox-harness/claude/hooks/adapter.py", "--host", "claude", "--event", "Stop", "--hook-scope", "project"],
						"timeout": 60
					}
				]
			}
		],
		"SessionStart": [
			{
				"matcher": "^(startup|resume|clear|compact|fork)$",
				"hooks": [
					{
						"type": "command",
						"command": "python3",
						"args": ["-B", "${CLAUDE_PROJECT_DIR}/.roblox-harness/claude/hooks/adapter.py", "--host", "claude", "--event", "SessionStart", "--hook-scope", "project"],
						"timeout": 1200
					}
				]
			}
		],
		"PreCompact": [
			{
				"matcher": "auto|manual",
				"hooks": [
					{
						"type": "command",
						"command": "python3",
						"args": ["-B", "${CLAUDE_PROJECT_DIR}/.roblox-harness/claude/hooks/adapter.py", "--host", "claude", "--event", "PreCompact", "--hook-scope", "project"],
						"timeout": 60
					}
				]
			}
		],
		"SubagentStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "python3",
						"args": ["-B", "${CLAUDE_PROJECT_DIR}/.roblox-harness/claude/hooks/adapter.py", "--host", "claude", "--event", "SubagentStart", "--hook-scope", "project"],
						"timeout": 30
					}
				]
			}
		],
		"SubagentStop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "python3",
						"args": ["-B", "${CLAUDE_PROJECT_DIR}/.roblox-harness/claude/hooks/adapter.py", "--host", "claude", "--event", "SubagentStop", "--hook-scope", "project"],
						"timeout": 60
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "python3",
						"args": ["-B", "${CLAUDE_PROJECT_DIR}/.roblox-harness/claude/hooks/adapter.py", "--host", "claude", "--event", "UserPromptSubmit", "--hook-scope", "project"],
						"timeout": 30
					}
				]
			}
		]
	}
}
