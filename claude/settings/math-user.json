{
  "__doc": "Owned user-level math-tool lifecycle hooks. Normal settings trust remains required after changed bytes.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}}",
            "args": ["-B", "{{MATH_GATE}}", "--host", "claude", "--event", "SessionStart"],
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}}",
            "args": ["-B", "{{MATH_GATE}}", "--host", "claude", "--event", "UserPromptSubmit"],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}}",
            "args": ["-B", "{{MATH_GATE}}", "--host", "claude", "--event", "PreToolUse"],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}}",
            "args": ["-B", "{{MATH_GATE}}", "--host", "claude", "--event", "PostToolUse"],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}}",
            "args": ["-B", "{{MATH_GATE}}", "--host", "claude", "--event", "PostToolUseFailure"],
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}}",
            "args": ["-B", "{{MATH_GATE}}", "--host", "claude", "--event", "Stop"],
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}}",
            "args": ["-B", "{{MATH_GATE}}", "--host", "claude", "--event", "PreCompact"],
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "clear|resume|logout|prompt_input_exit|other",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}}",
            "args": ["-B", "{{MATH_GATE}}", "--host", "claude", "--event", "SessionEnd"],
            "timeout": 3
          }
        ]
      }
    ]
  }
}
